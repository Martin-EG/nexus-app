# Copy to .env.local and fill in real values. Do not commit .env.local.

# Public URL of this Next.js app (used by NextAuth for callbacks).
NEXTAUTH_URL=http://localhost:3001

# Secret used to sign/encrypt the session JWT.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of the Nexus NestJS API (server-side only).
# The API defaults to port 3000, so run this client on another port,
# e.g. `next dev -p 3001`.
API_URL=http://localhost:3000
